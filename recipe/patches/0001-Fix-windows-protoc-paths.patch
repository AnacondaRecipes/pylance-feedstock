From 1265852bb71db27d3af97b870d826cff3088e23a Mon Sep 17 00:00:00 2001
From: Andrii Vetroumov <avetroumov@anaconda.com>
Date: Wed, 16 Sep 2026 18:24:21 +0300
Subject: [PATCH] Fix windows protoc paths

---
 rust/lance-index/build.rs | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/rust/lance-index/build.rs b/rust/lance-index/build.rs
index b47744f7b..4cf8213e0 100644
--- a/rust/lance-index/build.rs
+++ b/rust/lance-index/build.rs
@@ -16,6 +16,16 @@ fn main() -> Result<()> {
         std::env::set_var("PROTOC", protobuf_src::protoc());
     }
 
+    let manifest_dir = env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR not set");
+    let orig_dir = env::current_dir()?;
+    // Run protoc with CWD = crate root, using short relative paths only.
+    // This sidesteps the Windows command-line quoting bug where absolute
+    // paths (with drive letters / trailing backslashes) get mangled when
+    // passed through prost-build -> protoc, causing spurious
+    // "File does not reside within any path specified using --proto_path"
+    // errors even when the paths are provably identical on the Rust side.
+    env::set_current_dir(&manifest_dir)?;
+
     let mut prost_build = prost_build::Config::new();
     prost_build.protoc_arg("--experimental_allow_proto3_optional");
     prost_build.enable_type_names();
@@ -28,6 +38,11 @@ fn main() -> Result<()> {
         &["./protos", "./protos-cache"],
     )?;
 
+    // Always restore CWD before propagating any error, so a failure here
+    // doesn't leave later cargo/build-script logic running from the wrong dir.
+    env::set_current_dir(&orig_dir)?;
+    result?;
+    
     let rust_toolchain = env::var("RUSTUP_TOOLCHAIN")
         .or_else(|e| match e {
             env::VarError::NotPresent => Ok("stable".into()),
-- 
