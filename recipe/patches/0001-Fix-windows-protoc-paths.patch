From 350d8f59b6bc0d08d3f5bb8e2a04df1e716e0ec2 Mon Sep 17 00:00:00 2001
From: Andrii Vetroumov <avetroumov@anaconda.com>
Date: Wed, 16 Sep 2026 15:22:02 +0300
Subject: [PATCH] Fix windows protoc paths

---
 rust/lance-index/build.rs | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/rust/lance-index/build.rs b/rust/lance-index/build.rs
index b47744f7b..3a8008e53 100644
--- a/rust/lance-index/build.rs
+++ b/rust/lance-index/build.rs
@@ -3,6 +3,7 @@
 
 use std::env;
 use std::io::Result;
+use std::path::Path;
 
 fn main() -> Result<()> {
     println!("cargo:rerun-if-changed=protos");
@@ -16,18 +17,23 @@ fn main() -> Result<()> {
         std::env::set_var("PROTOC", protobuf_src::protoc());
     }
 
+    let manifest_dir = env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR not set");
+    let proto_dir = Path::new(&manifest_dir).join("protos").canonicalize()?;
+    let proto_cache_dir = Path::new(&manifest_dir).join("protos-cache").canonicalize()?;
+
+    let index_proto = proto_dir.join("index.proto").canonicalize()?;
+    let index_old_proto = proto_dir.join("index_old.proto").canonicalize()?;
+    let cache_proto = proto_cache_dir.join("cache.proto").canonicalize()?;
+
     let mut prost_build = prost_build::Config::new();
     prost_build.protoc_arg("--experimental_allow_proto3_optional");
     prost_build.enable_type_names();
     prost_build.compile_protos(
-        &[
-            "./protos/index.proto",
-            "./protos/index_old.proto",
-            "./protos-cache/cache.proto",
-        ],
-        &["./protos", "./protos-cache"],
+        &[index_proto, index_old_proto, cache_proto],
+        &[proto_dir.as_path(), proto_cache_dir.as_path()],
     )?;
 
+
     let rust_toolchain = env::var("RUSTUP_TOOLCHAIN")
         .or_else(|e| match e {
             env::VarError::NotPresent => Ok("stable".into()),
-- 
