From 87d8e76ce71f1951e7347f08570760badb24ff4a Mon Sep 17 00:00:00 2001
From: Esteban Gutierrez <esteban@lancedb.com>
Date: Wed, 21 Oct 2026 14:23:13 -0500
Subject: [PATCH 2/5] ci: allow the trust-store crates through the dependency
 age gate

rustls-webpki 0.103.16, webpki-roots 1.0.10 and webpki-root-certs 1.0.10 were published less than 48 hours before this change. They carry the eMudhra intermediate distrust (RUSTSEC-2026-0382 / CVE-2026-111943), so the fix cannot wait for the floor. The entries become inert once the versions pass it.

Co-authored-by: Claude Opus 5.1 <noreply@anthropic.com>
---
 ci/dependency-age-allowlist.toml | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/ci/dependency-age-allowlist.toml b/ci/dependency-age-allowlist.toml
index 60866509a4e..6b7c1c34273 100644
--- a/ci/dependency-age-allowlist.toml
+++ b/ci/dependency-age-allowlist.toml
@@ -13,3 +13,18 @@
 # crate = "some-crate"
 # version = "1.2.3"
 # reason = "RUSTSEC-2026-0000, allowlisted in Aikido 2026-09-16"
+
+[[allow]]
+crate = "rustls-webpki"
+version = "0.103.16"
+reason = "RUSTSEC-2026-0382 / CVE-2026-111943: rejects chains that carry the compromised eMudhra intermediate keys; Aikido still serves an index without this version to developer machines as of 2026-10-21"
+
+[[allow]]
+crate = "webpki-roots"
+version = "1.0.10"
+reason = "drops emSign ECC Root CA - G3 after the eMudhra intermediate compromise; Aikido still serves an index without this version to developer machines as of 2026-10-21"
+
+[[allow]]
+crate = "webpki-root-certs"
+version = "1.0.10"
+reason = "drops emSign ECC Root CA - G3 after the eMudhra intermediate compromise; Aikido still serves an index without this version to developer machines as of 2026-10-21"

From 6c5c5569e5e6b7647f72a38fb32b53db406b7eaf Mon Sep 17 00:00:00 2001
